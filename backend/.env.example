# Railway Environment Variables

# Port (Railway автоматически задает PORT)
# PORT=8000 (auto set by Railway)

# Database (используем SQLite локально, Railway может подключить PostgreSQL)
DATABASE_URL=sqlite:///./cows.db

# ML настройки
DETECTION_CONFIDENCE=0.5
RECOGNITION_CONFIDENCE=0.70

# CORS - Обязательно для Netlify frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cowidentity.netlify.app

# Security
SECRET_KEY=your-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server
HOST=0.0.0.0
PORT=8000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads
